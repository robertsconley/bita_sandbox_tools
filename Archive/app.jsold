function MagicSwordPrimary(RollTwo)
{
	if (RollTwo === undefined) {
		RollTwo = false;
	}

	var Roll = D(100);
	var SB = new StringBuilder();
	var num = Roll;
	var aMagicSwordPrimary;
	if (num >= 1 && num <= 15)
	{
		aMagicSwordPrimary = "Detect Shifting Walls & Rooms";
	}
	else if (num >= 16 && num <= 30)
	{
		aMagicSwordPrimary = "Detect Sloping Passages";
	}
	else if (num >= 31 && num <= 40)
	{
		aMagicSwordPrimary = "Locate Secret Doors";
	}
	else if (num >= 41 && num <= 50)
	{
		aMagicSwordPrimary = "Detect Traps";
	}
	else if (num >= 51 && num <= 60)
	{
		aMagicSwordPrimary = "See Invisible";
	}
	else if (num >= 61 && num <= 64)
	{
		aMagicSwordPrimary = "Detect Evil";
	}
	else if (num >= 64 && num <= 68)
	{
		aMagicSwordPrimary = "Detect Gold";
	}
	else if (num >= 69 && num <= 70)
	{
		aMagicSwordPrimary = "Detect Gold & Evil";
	}
	else if (num >= 71 && num <= 80)
	{
		aMagicSwordPrimary = "Detect Metal";
	}
	else if (num >= 81 && num <= 90)
	{
		aMagicSwordPrimary = "Detect Magic";
	}
	else if (num >= 91 && num <= 95)
	{
		aMagicSwordPrimary = "Detect Gems";
	}
	else if (num >= 96 && num <= 99)
	{
		if (RollTwo)
		{
			aMagicSwordPrimary = MagicSwordPrimary(true);
		}
		else
		{
			SB.Append(MagicSwordPrimary(true));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(true));
			aMagicSwordPrimary = SB.ToString();
		}
	}
	else if (num == 0)
	{
		aMagicSwordPrimary = MagicSwordExtraOrdinary(false);
	}
	else
	{
		aMagicSwordPrimary = "*NOTHING*" + Roll;
	}
	return aMagicSwordPrimary;
}

function MagicSwordEgoBonus(Primary)
{
	
	{
		var TempI = 0;
		if (Primary.indexOf("Clairaudience") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Clairvoyance") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("ESP") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Telepathy") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Telekenesis") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Teleportation") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("X-Ray Vision") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Generate Illusion") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Levitation") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Flying") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Healing") > 0)
		{
			TempI++;
		}
		if (Primary.indexOf("Enhanced Strength") > 0)
		{
			TempI++;
		}
		return TempI;
	}
}

