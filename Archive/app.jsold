	else if (num >= 93 && num <= 97)
	{
		MagicSwordExtraOrdinary = "Enhanced Strength";
	}
	else if (num >= 98 && num <= 99)
	{
		if (TakeRoll)
		{
			MagicSwordExtraOrdinary = MagicSwordExtraOrdinary(true);
		}
		else
		{
			SB.Append(MagicSwordExtraOrdinary(true));
			SB.Append(", ");
			SB.Append(MagicSwordExtraOrdinary(true));
			MagicSwordExtraOrdinary = SB.ToString();
		}
	}
	else if (num == 100)
	{
		if (TakeRoll)
		{
			MagicSwordExtraOrdinary = MagicSwordExtraOrdinary(true);
		}
		else
		{
			SB.Append(MagicSwordExtraOrdinary(true));
