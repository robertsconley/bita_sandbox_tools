function MagicScroll()
{
	var Roll = D(100);
	var num = Roll;
	var MagicScroll;
	if (num >= 1 && num <= 20)
	{
		if (D(4) == 1)
		{
			MagicScroll = "Scroll of 1 Cleric Spell";
		}
		else
		{
			MagicScroll = "Scroll of 1 Wizard Spell";
		}
	}
	else if (num >= 21 && num <= 35)
	{
		if (D(4) == 1)
		{
			MagicScroll = "Scroll of 2 Cleric Spells";
		}
		else
		{
			MagicScroll = "Scroll of 2 Wizard Spells";
		}
	}
	else if (num >= 36 && num <= 45)
	{
		if (D(4) == 1)
		{
			MagicScroll = "Scroll of 3 Cleric Spells";
		}
		else
		{
			MagicScroll = "Scroll of 3 Wizard Spells";
		}
	}
	else if (num >= 46 && num <= 50)
	{
		if (D(4) == 1)
		{
			MagicScroll = "Scroll of 7 Cleric Spells";
		}
		else
		{
			MagicScroll = "Scroll of 7 Wizard Spells";
		}
	}
	else
	{
		if (num >= 51 && num <= 60)
		{
			Roll = D(8);
			var num2 = Roll;
			if (num2 >= 1 && num2 <= 2)
			{
				MagicScroll = "Cursed Scroll, Summon Monster";
				return MagicScroll;
			}
			if (num2 >= 3 && num2 <= 4)
			{
				MagicScroll = "Cursed Scroll, Fatal Disease (3 turns)";
				return MagicScroll;
			}
			if (num2 >= 5 && num2 <= 6)
			{
				MagicScroll = "Cursed Scroll, Polymorph to Insect";
				return MagicScroll;
			}
			if (num2 == 7)
			{
				MagicScroll = "Cursed Scroll, Random Teleport 1,000 miles";
				return MagicScroll;
			}
			if (num2 == 8)
			{
				MagicScroll = "Cursed Scroll, Transported to another planet";
				return MagicScroll;
			}
		}
		else
		{
			if (num >= 61 && num <= 70)
			{
				MagicScroll = "Scroll of Prot: Lycanthropes";
				return MagicScroll;
			}
			if (num >= 71 && num <= 80)
			{
				MagicScroll = "Scroll of Prot: Undead";
				return MagicScroll;
			}
			if (num >= 81 && num <= 90)
			{
				MagicScroll = "Scroll of Prot: Elementals";
				return MagicScroll;
			}
			if (num >= 91 && num <= 100)
			{
				MagicScroll = "Scroll of Prot: Magic";
				return MagicScroll;
			}
		}
		MagicScroll = "*NOTHING*" + Roll;
	}
	return MagicScroll;
}

