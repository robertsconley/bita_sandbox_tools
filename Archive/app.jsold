function TreasureMap(Roll = 0)
{
	var SB = new StringBuilder();
	if (Roll == 0)
	{
		SB.Append("Map To (");
	}
	if (Roll == 0)
	{
		Roll = D(8);
	}

	{
		switch (Roll)
		{
		case 1:
			SB.Append(numberWithCommas(D(4) * 10000));
			SB.Append(" SP");
			break;
		case 2:
			SB.Append(numberWithCommas(_5D6()));
			SB.Append(" GP");
			break;
		case 3:
			SB.Append(numberWithCommas(D(4) * 10000));
			SB.Append(" SP; ");
			SB.Append(numberWithCommas(_5D6()));
			SB.Append(" GP");
			break;
		case 4:
			SB.Append(numberWithCommas(D(4) * 10000));
			SB.Append(" SP; ");
			SB.Append(GenGems(_2D10()));
			break;
		case 5:
			SB.Append(numberWithCommas(_5D6()));
			SB.Append(" GP; ");
			SB.Append(GenGems(_5D6()));
			break;
		case 6:
			SB.Append(numberWithCommas(D(4) * 10000));
			SB.Append(" SP; ");
			SB.Append(numberWithCommas(_5D6()));
			SB.Append(" GP; ");
			SB.Append(GenGems(D(100)));
			break;
		case 7:
			SB.Append(GenGems(_1D6() * 10));
			SB.Append("; ");
			SB.Append(GenJewelry(_2D10()));
			break;
		case 8:
			SB.Append(numberWithCommas(D(4) * 10000));
			SB.Append(" SP; ");
			SB.Append(numberWithCommas(_5D6()));
			SB.Append(" GP; ");
			SB.Append(GenGems(_1D6() * 10));
			SB.Append("; ");
			SB.Append(GenJewelry(_2D10()));
			break;
		}
		SB.Append(")");
		return SB.ToString();
	}
}

function MagicMap(Roll = 0)
{
