function Generate_Dungeon() {
	var SB = new StringBuilder();
	var result = "";
	var nRooms = "";
	nRooms = document.forms["myDungeonForm"]["nDungeonRooms"].value
	result =  Generate_Rooms(nRooms);
	document.getElementById("contentDungeon").innerHTML = result;
	document.getElementById("contentcopyTreasure").value = result;
	document.getElementById("contentcopyarea").value = result;
	return;
}
function Generate_Rooms(NumberOfRooms) {
	var SB = new StringBuilder();
	if (NumberOfRooms === undefined) {
		NumberOfRooms = 1;
	}
	for (i = 0; i < NumberOfRooms; i++) {
		if (i > 0) {
			SB.Append("<br>");
		}
		var index = i + 1;
		SB.Append(index);
		SB.Append("-");
		SB.Append(RoomContent());
	}
	SB.Append("<br>");
	return SB.ToString();
}


function RoomContent()
{
	var result = new RandomTable();
	result.Add("Monster" + GenMonsterTreasure(), 1, 2);
	result.Add("Trap" + GenTrapTreasure(), 3, 3);
	result.Add("Special", 4, 4);
	result.Add("Empty" + GenEmptyTreasure(), 5, 6);
	return result.Generate(D(6));
}

function GenMonsterTreasure() {
	var result = ", Treasure, No";
	var roll = D(6);
	if (roll < 4) {
		result = ", Treasure, Yes";
	}
	return result;
}

function GenTrapTreasure() {
	var result = ", Treasure, No";
	var roll = D(6);
	if (roll < 3) {
		result = ", Treasure, Yes";
	}
	return result;
}

function GenEmptyTreasure() {
	var result = ", Treasure, No";
	var roll = D(6);
	if (roll == 1) {
		result = ", Treasure, Yes";
	}
	return result;
}
