function MagicItem(NoSwords)
{
	if (NoSwords === undefined) {
		NoSwords = false;
	}
	var Roll = D(100);
	var num = Roll;
	var aMagicItem = "";
	if (num >= 1 && num <= 20)
	{
		if (NoSwords)
		{
			aMagicItem = MagicItem(NoSwords);
		}
		else
		{
			aMagicItem = MagicSword();
		}
	}
	else if (num >= 21 && num <= 35)
	{
		aMagicItem = MagicArmor();
	}
	else if (num >= 36 && num <= 40)
	{
		if (NoSwords)
		{
			aMagicItem = MagicItem(NoSwords);
		}
		else
		{
			aMagicItem = MagicMiscWeapons();
		}
	}
	else if (num >= 41 && num <= 65)
	{
		aMagicItem = MagicPotion(false);
	}
	else if (num >= 66 && num <= 85)
	{
		aMagicItem = MagicScroll();
	}
	else if (num >= 86 && num <= 90)
	{
		aMagicItem = MagicRing(false);
	}
	else if (num >= 91 && num <= 95)
	{
		aMagicItem = MagicWand();
	}
	else if (num >= 96 && num <= 100)
	{
		aMagicItem = MagicMisc();
	}
	else
	{
		aMagicItem = "*NOTHING*" + Roll;
	}
	return aMagicItem;
}

function MagicSword()
{
	var Align = "";
	var Primary = "";
	var Ego = 0;
	var Purpose = "";
	var SB = new StringBuilder();
	var num = D(100);
	if (num >= 1 && num <= 65)
	{
		Align = "Lawful";
	}
	else if (num >= 66 && num <= 90)
	{
		Align = "Neutral";
	}
	else if (num >= 91 && num <= 100)
	{
		Align = "Chaotic";
	}
	var num2 = D(12);
	
	{
		if (num2 >= 1 && num2 <= 6)
		{
			Primary = "";
		}
		else if (num2 == 7)
		{
			Primary = MagicSwordPrimary(false) + ", Empathy";
			Ego = D(12) + MagicSwordEgoBonus(Primary);
		}
		else if (num2 == 8)
		{
			SB = new StringBuilder();
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", Empathy");
			Primary = SB.ToString();
			Ego = D(12) + MagicSwordEgoBonus(Primary);
		}
		else if (num2 == 9)
		{
			SB = new StringBuilder();
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", Empathy");
			Primary = SB.ToString();
			Ego = D(12) + MagicSwordEgoBonus(Primary);
		}
		else if (num2 == 10)
		{
			SB = new StringBuilder();
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append("Speaks ");
			SB.Append(MagicSwordLang(false));
			SB.Append(" Languages");
			Primary = SB.ToString();
			Ego = D(12) + MagicSwordEgoBonus(Primary);
		}
		else if (num2 == 11)
		{
			SB = new StringBuilder();
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append("Speaks ");
			SB.Append(MagicSwordLang(false).ToString());
			SB.Append(" Languages");
			SB.Append(", Reads Magic");
			Primary = SB.ToString();
			Ego = D(12) + MagicSwordEgoBonus(Primary);
		}
		else if (num2 == 12)
		{
			SB = new StringBuilder();
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append(MagicSwordPrimary(false));
			SB.Append(", ");
			SB.Append("Speaks ");
			SB.Append(MagicSwordLang(false).ToString());
			SB.Append(" Languages");
			SB.Append(", Reads Magic");
			SB.Append(", Telepathy");
			Primary = SB.ToString();
			Ego = D(12) + MagicSwordEgoBonus(Primary);
		}
		if (D(100) >= 91)
		{
			SB = new StringBuilder();
			if (Align == "Lawful")
			{
				Purpose = MagicSwordPurposeLaw() + ", Paralyze Chaos";
			}
			else if (Align == "Neutral")
			{
				Purpose = MagicSwordPurposeNeutral() + ", +1 to all saves";
			}
			else if (Align == "Chaotic")
			{
				Purpose = MagicSwordPurposeChaos() + ", Paralyze Law";
			}
		}
		SB = new StringBuilder();
		SB.Append(Align);
		SB.Append(" ");
		SB.Append(MagicSwordType());
		if (Primary != "")
		{
			SB.Append(" with ");
			SB.Append(Primary);
			if (Primary != "")
			{
				SB.Append("; ");
				SB.Append(Purpose);
			}
		}
		else if (Primary != "")
		{
			SB.Append(" with ");
			SB.Append(Purpose);
		}
		if (Ego > 0)
		{
			if (Purpose != "") SB.Append(";");
			SB.Append(" Ego ");
			SB.Append(Ego);
		}
		return SB.ToString();
	}
}

