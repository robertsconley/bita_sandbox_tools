		SB.Append("; ");
		SB.Append(MagicItem(false));
		SB.Append("; ");
		SB.Append(MagicPotion(false));
		SB.Append("; ");
		SB.Append(MagicScroll());
	}
	SB.Append(")");
	return SB.ToString();
}

