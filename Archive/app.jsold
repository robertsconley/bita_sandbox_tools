	{
		SB.Append(MagicItem(false));
		SB.Append("; ");
		SB.Append(MagicItem(false));
	}
	else if (num == 6)
	{
		SB.Append(MagicItem(true));
		SB.Append("; ");
		SB.Append(MagicItem(true));
		SB.Append("; ");
		SB.Append(MagicItem(true));
