function UnguardedLevel1()
{
	var TempS = "";
	var Roll = 0;
	TempS = TempS + numberWithCommas(D(6) * 100) + " SP";
	Roll = D(100);
	if (Roll <= 50)
	{
		TempS = TempS + "; " + numberWithCommas(D(6) * 10) + " GP";
	}
	Roll = D(100);
	if (Roll <= 5)
	{		
		TempS = TempS + "; " + GenGems(D(6));
	}
	Roll = D(100);
	if (Roll <= 5)
	{
		TempS = TempS + "; " + GenJewelry(D(6));
	}
	Roll = D(100);
	if (Roll <= 2)
	{
		TempS = TempS + "; " + GenMagicItem(1);
	}
	return TempS;
}

