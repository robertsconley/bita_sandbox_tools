function CopyContent() {
  var copyText = document.getElementById("contentcopyTreasure");
  copyText.value = document.getElementById("contentTreasure").innerHTML
  copyText.select();
  copyText.setSelectionRange(0, 99999)
  document.execCommand("copy");
  alert("Treasure: " + copyText.value);

}

function CopySword() {
  var copyText = document.getElementById("contentcopyTreasure");
  copyText.value = document.getElementById("contentSword").innerHTML
  copyText.select();
  copyText.setSelectionRange(0, 99999)
  document.execCommand("copy");
  alert("Treasure: " + copyText.value);

}

function CopyDungeon() {
  var copyText = document.getElementById("contentcopyarea");
  var brRegex = /<br\s*[\/]?>/gi;
  var dungeonText = document.getElementById("contentDungeon").innerHTML;  
  copyText.value = dungeonText.replace(brRegex,"\r\n");
  copyText.select();
  copyText.setSelectionRange(0, 99999)
  document.execCommand("copy");
  alert("Taken!");

}

function CopyDungeonOld() {
  var copyText = document.getElementById("contentcopyTreasure");
  copyText.value = document.getElementById("contentDungeon").innerHTML
  copyText.select();
  copyText.setSelectionRange(0, 99999)
  document.execCommand("copy");
  alert(copyText.value);

}

