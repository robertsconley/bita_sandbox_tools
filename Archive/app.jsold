	}
	else if (num >= 27 && num <= 29)
	{
		SB.Append("Flying");
	}
	else if (num >= 30 && num <= 32)
	{
		SB.Append("ESP");
	}
	else if (num >= 33 && num <= 35)
	{
		if (Delusion)
		{
			SB.Append("ESP");
		}
		else
