function MagicPotion(Delusion)
{
	if (Delusion === undefined) {
		Delusion = false;
	}
	var SB = new StringBuilder();
	SB.Append("Potion of ");
	var num = D(100);
	if (num >= 1 && num <= 3)
	{
		SB.Append("Growth");
	}
	else if (num >= 4 && num <= 6)
	{
		SB.Append("Diminuation");
	}
	else if (num >= 7 && num <= 10)
	{
		switch (D(6))
		{
		case 1:
			SB.Append("Hill Giant");
			break;
		case 2:
			SB.Append("Stone Giant");
			break;
		case 3:
			SB.Append("Frost Giant");
			break;
		case 4:
			SB.Append("First Giant");
			break;
		case 5:
			SB.Append("Cloud Giant");
			break;
